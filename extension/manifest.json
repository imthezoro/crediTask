{
  "manifest_version": 3,
  "name": "PromptOK",
  "version": "1.0.0",
  "description": "Clarify and enhance prompts across LLM sites",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://coqwcumwpixmrjqnmhkv.supabase.co https://openrouter.ai https://*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://localhost/*/dashboard*",
        "*://localhost/dashboard*",
        "*://127.0.0.1/*/dashboard*",
        "*://127.0.0.1/dashboard*",
        "*://localhost/*/auth/callback*",
        "*://localhost/auth/callback*",
        "*://127.0.0.1/*/auth/callback*",
        "*://127.0.0.1/auth/callback*"
      ],
      "js": ["enhanced-content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://localhost/*/dashboard*",
        "*://localhost/dashboard*",
        "*://127.0.0.1/*/dashboard*",
        "*://127.0.0.1/dashboard*"
      ],
      "js": ["dashboard-auth.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://localhost/*/auth/callback*",
        "*://localhost/auth/callback*",
        "*://127.0.0.1/*/auth/callback*",
        "*://127.0.0.1/auth/callback*"
      ],
      "js": ["dashboard-auth.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/*",
        "fonts/*",
        "popup.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}


