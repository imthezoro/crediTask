{
  "manifest_version": 3,
  "name": "PromptOK",
  "version": "1.0.0",
  "description": "Clarify and enhance prompts across LLM sites",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://coqwcumwpixmrjqnmhkv.supabase.co https://openrouter.ai; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "*://chat.openai.com/*",
    "*://*.chatgpt.com/*",
    "*://*.claude.ai/*",
    "*://bard.google.com/*",
    "*://gemini.google.com/*",
    "*://*.poe.com/*",
    "*://*.character.ai/*",
    "*://*.perplexity.ai/*",
    "*://*.you.com/*",
    "*://copilot.microsoft.com/*",
    "*://huggingface.co/*",
    "*://replicate.com/*",
    "*://openrouter.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://bard.google.com/*",
        "*://gemini.google.com/*",
        "*://*.poe.com/*",
        "*://*.character.ai/*",
        "*://*.perplexity.ai/*",
        "*://*.you.com/*",
        "*://copilot.microsoft.com/*",
        "*://huggingface.co/*",
        "*://replicate.com/*",
        "*://openrouter.ai/*"
      ],
      "js": [
        "env-config.js",
        "content-scripts/content-constants.js",
        "content-scripts/content-selectors.js",
        "content-scripts/content-config.js",
        "content-scripts/content-styles.js",
        "content-scripts/content-dom.js",
        "content-scripts/content-state.js",
        "content-scripts/content-auth.js",
        "content-scripts/content-ui.js",
        "enhanced-content.js"
      ],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "css/*",
        "font/*",
        "popup.html"
      ],
      "matches": [
        "*://chat.openai.com/*",
        "*://*.chatgpt.com/*",
        "*://*.claude.ai/*",
        "*://bard.google.com/*",
        "*://gemini.google.com/*",
        "*://*.poe.com/*",
        "*://*.character.ai/*",
        "*://*.perplexity.ai/*",
        "*://*.you.com/*",
        "*://copilot.microsoft.com/*",
        "*://huggingface.co/*",
        "*://replicate.com/*",
        "*://openrouter.ai/*"
      ]
    }
  ]
}


